# Sao chép file này thành .env rồi điền giá trị thật.

# RPC endpoint Sepolia (lấy từ Alchemy / Infura — tạo app miễn phí)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key của ví testnet (dạng 0x...). LẤY TỪ VÍ MỚI, KHÔNG PHẢI VÍ CHÍNH.
PRIVATE_KEY=0xyour_testnet_private_key

# (Tùy chọn) API key Etherscan để verify contract
ETHERSCAN_API_KEY=your_etherscan_api_key
